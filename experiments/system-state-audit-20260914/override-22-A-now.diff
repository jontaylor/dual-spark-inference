+"""GPU-only event snapshots and resident-tail restores; no model-weight loading."""
+from dataclasses import replace
+
+import torch
+
+from vllm.v1.kv_offload.gb10_gpu_checkpoint import launch
+
+
+def capture_gpu_completions(connector, runner, metadata):
+    from vllm.distributed.kv_transfer.kv_connector.v1.gb10_completion import (
+        CompletionMetadata, group_spec,
+    )
+    from vllm.v1.kv_cache_interface import MambaSpec
+    from vllm.model_executor.layers.mamba.mamba_utils import (
+        get_conv_copy_spec, get_temporal_copy_spec, is_conv_state_dim_first,
+    )
+    if not isinstance(metadata, CompletionMetadata) or not metadata.completion_saves:
+        return metadata
+    worker = connector.connector_worker.worker
+    groups = connector._completion_groups
+    funcs = runner.model.get_mamba_state_copy_funcs({
+        group_spec(g).mamba_type for g in groups if isinstance(group_spec(g), MambaSpec)
+    })
+    context = runner.vllm_config.compilation_config.static_forward_context
+    descriptors, tables, job_pieces, remaining = [], [], {}, {}
+    boundaries = torch.zeros_like(runner.req_states.num_computed_tokens.gpu)
+    # GPU scalar assignment is asynchronous. No accepted-state CPU read occurs.
+    for rid, save in metadata.completion_saves.items():
+        job = metadata.store_jobs[save.job_id]
+        if not getattr(job.dst_spec, 'direct_gpu', False):
+            remaining[rid] = save
+            continue
+        worker.completion_gpu_jobs.add(save.job_id)
+        ri = runner.req_states.req_id_to_index.get(rid)
+        if ri is None:
+            connector._invalid_completions.add(save.job_id)
+            continue
+        boundaries[ri] = save.record.boundary
+        destinations = {}
+        cursor = 0
+        for gi, n in enumerate(job.src_spec.group_sizes):
+            if isinstance(group_spec(groups[gi]), MambaSpec):
+                if n != 1:
+                    raise RuntimeError('A recurrent snapshot must have one destination per group')
+                destinations[gi] = job.dst_spec.memory_blocks[cursor]
+            cursor += n
+        start = len(descriptors)
+        for gi, dst in destinations.items():
+            ids = save.block_ids[gi]
+            table = torch.tensor(ids, device='cuda', dtype=torch.int32)
+            tables.append(table)
+            group = groups[gi]
+            spec = group_spec(group)
+            for layer in group.layer_names:
+                per_layer = getattr(group.kv_cache_spec, 'kv_cache_specs', {}).get(layer, spec)
+                caches = context[layer].kv_cache
+                copy_funcs = funcs[per_layer.mamba_type]
+                if len(caches) != len(copy_funcs):
+                    raise RuntimeError('Unrepresented recurrent checkpoint state')
+                for tensor, copy_func in zip(caches, copy_funcs):
+                    if not tensor[0].is_contiguous() or not 0 < dst < tensor.shape[0]:
+                        raise RuntimeError('Invalid recurrent GPU snapshot layout/destination')
+                    if copy_func is get_conv_copy_spec:
+                        axis = 1 if is_conv_state_dim_first() else 0
+                        axis_stride = tensor[0].stride(axis) * tensor.element_size()
+                        axis_length = tensor[0].shape[axis]
+                    elif copy_func is get_temporal_copy_spec:
+                        axis_stride, axis_length = 0, 1
+                    else:
+                        raise RuntimeError('Unsupported recurrent checkpoint copy')
+                    descriptors.append([
+                        tensor.data_ptr(), tensor[dst].data_ptr(),
+                        tensor[0].numel() * tensor.element_size(),
+                        tensor.stride(0) * tensor.element_size(), tensor.shape[0],
+                        table.data_ptr(), len(ids), ri, axis_stride, axis_length,
+                    ])
+        job_pieces[save.job_id] = (start, len(descriptors))
+    if descriptors:
+        desc = torch.tensor(descriptors, device='cuda', dtype=torch.int64)
+        status = torch.zeros(len(descriptors), device='cuda', dtype=torch.int32)
+        launch(desc, runner.req_states.num_computed_tokens.gpu,
+               runner.model_state.num_accepted_tokens_gpu,
+               runner.model_state._mamba_state_idx_gpu, boundaries, status,
+               max(d[2] for d in descriptors), runner.num_speculative_steps)
+        # One small validity result for the whole event batch. State stays on
+        # GPU. This also fences descriptor/table lifetimes before returning.
+        valid = status.cpu().tolist()
+        for jid, (start, end) in job_pieces.items():
+            if start == end or not all(valid[start:end]):
+                connector._invalid_completions.add(jid)
+    return replace(metadata, completion_saves=remaining)
+
+
+def copy_resident_pages(worker, gpu, disk, store):
+    """Copy only missing GPU tails. Borrowed store pages require no copy."""
+    if store:
+        # Recurrent destinations were filled/validated before source-slot reuse.
+        # Attention and ring destinations alias the immutable source pages.
+        return
+    descriptors, tables = [], []
+    cursor = 0
+    for gi, n in enumerate(gpu.group_sizes):
+        for i in range(n):
+            src = disk.memory_blocks[cursor + i]
+            dst = int(gpu.block_ids[cursor + i])
+            if src < 0:
+                raise RuntimeError('Mixed disk/GPU copy passed to resident-only helper')
+            if src == dst:
+                continue
+            table = torch.tensor([src], device='cuda', dtype=torch.int32)
+            tables.append(table)
+            for ref in worker.kv_caches.group_data_refs[gi]:
+                cached = worker.kv_caches.tensors[ref.tensor_idx]
+                raw = cached.tensor.view(torch.uint8).reshape(-1, cached.page_size_bytes)
+                if not (0 < src < raw.shape[0] and 0 < dst < raw.shape[0]):
+                    raise RuntimeError('Invalid resident copy source/destination')
+                descriptors.append([raw.data_ptr(), raw[dst].data_ptr(), ref.page_size_bytes,
+                                    cached.page_size_bytes, raw.shape[0], table.data_ptr(),
+                                    1, 0, 0, 1])
+        cursor += n
+    if descriptors:
+        desc = torch.tensor(descriptors, device='cuda', dtype=torch.int64)
+        one = torch.ones(1, dtype=torch.int32, device='cuda')
+        zero = torch.zeros_like(one)
+        statuses = torch.zeros(len(desc), dtype=torch.int32, device='cuda')
+        launch(desc, one, one, zero, one, statuses, max(d[2] for d in descriptors))
+        if not bool(statuses.all().item()):
+            raise RuntimeError('Resident GPU copy failed validation')
